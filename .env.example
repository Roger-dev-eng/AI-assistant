AWS_PROFILE=assistant-dev
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Enable only after configuring your AWS profile and checking model availability.
ASSISTANT_CLOUD_ENABLED=false
ASSISTANT_LANGUAGE=auto
ASSISTANT_VOICE_ENABLED=false
# Existing local model files only; the application never downloads voice models.
WHISPER_MODEL_PATH=
PIPER_VOICE_PT=
PIPER_VOICE_EN=
RECORDING_SECONDS=10
# Wake listening must be started explicitly in the UI; no automatic microphone activation.
WAKE_LISTEN_SECONDS=120
MONTHLY_BUDGET_USD=5
MAX_CLOUD_REQUESTS_PER_DAY=100
# Reference estimates only; update for the selected model/region/inference mode.
INPUT_USD_PER_MILLION=0.035
OUTPUT_USD_PER_MILLION=0.14
MAX_OUTPUT_TOKENS=512
MAX_INPUT_BYTES=24000
MAX_TOOL_ROUNDS=5
MEMORY_ENABLED=false
MEMORY_RETENTION_DAYS=7
MEMORY_MAX_TURNS=6
SECONDARY_MODEL_ID=
SECONDARY_INPUT_USD_PER_MILLION=
SECONDARY_OUTPUT_USD_PER_MILLION=
